PORT=4000
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Main DB for auth/users (shared across tenants)
MONGO_URI=mongodb://127.0.0.1:27017/ledgerguard_main

# HMAC secret for auth tokens (change in production)
JWT_SECRET=change-me-in-production

# Optional hard checks during JWT verification
JWT_ISSUER=ledgerguard-auth
JWT_AUDIENCE=ledgerguard-api

# Comma-separated tenant:key pairs (tenant ID followed by colon, then RSA public key PEM)
# Example:
# JWT_PUBLIC_KEYS=company_a:-----BEGIN PUBLIC KEY-----MII...-----END PUBLIC KEY-----,company_b:-----BEGIN PUBLIC KEY-----MII...-----END PUBLIC KEY-----
JWT_PUBLIC_KEYS=

# Each tenant must have a dedicated MongoDB URI.
# Key format: DB_URI_<TENANT_ID_UPPERCASED_AND_NON_ALNUM_REPLACED_WITH_UNDERSCORE>
# Example for tenant id `company_a`:
DB_URI_COMPANY_A=mongodb://127.0.0.1:27017/ledgerguard_company_a
